@inherits LayoutComponentBase

<PageTitle>AIDroneWars</PageTitle>

<div class="page @(sidebarCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <button class="sidebar-toggle-tab" @onclick="ToggleSidebar">
        <span class="tac-arrow">@(sidebarCollapsed ? ">" : "<")</span>
    </button>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool sidebarCollapsed = true;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }
}
